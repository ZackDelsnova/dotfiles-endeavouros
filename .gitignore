# matugen cache
.cache/matugen

# quickshell cache
*.qmlc
*.jsc
quickshell/*/qmlcache/

# system assets
assets/sddm/
assets/grub/

# temp
temp/
test/
*.tmp

# for safety
*.env
*.secret
*.key


