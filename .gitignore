# system/backups
*.swp
*.swo
*.bak
*~
*.log
.DS_Store
Thumbs.db

# hyprland
.hyprland-*

# nested git repos
**/.git/

# neovim cache & plugins
nvim/.config/nvim/.lazy/
nvim/.config/nvim/lazy-lock.json
nvim/.config/nvim/.mason/
nvim/.config/nvim/.backup/
nvim/.config/nvim/.swap/
